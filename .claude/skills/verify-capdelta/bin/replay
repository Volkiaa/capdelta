#!/usr/bin/env bash
# Replays the fixed drive set against the scenario repos and compares two
# recorded builds. Usage: replay setup | record <label> | compare <base> <head>
set -eu
BIN="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$BIN/../../../.." && pwd)"
SCRATCH="$HOME/.cache/capdelta-dedupe"
EVIDENCE="$HOME/.local/state/capdelta-verify"
SCENARIOS="$SCRATCH/scenarios.env"

usage() {
  printf 'usage: replay setup | record <label> | compare <base> <head>\n' >&2
  exit 2
}

setup() {
  export TMPDIR="$SCRATCH"
  export CAPDELTA_VERIFY_RUN_ID="dedupe-scenarios"
  export CAPDELTA_VERIFY_EVIDENCE="$EVIDENCE"
  mkdir -p "$TMPDIR" "$CAPDELTA_VERIFY_EVIDENCE/$CAPDELTA_VERIFY_RUN_ID"
  local allow="$CAPDELTA_VERIFY_EVIDENCE/$CAPDELTA_VERIFY_RUN_ID/husky-allow.yml"
  cat >"$allow" <<'YML'
allowlist:
  - package: husky
    capability: new-external-endpoint
    justification: "docs link verified"
YML
  local staging="$SCENARIOS.tmp"
  add() { printf '%s=%q\n' "$1" "$2"; }
  {
    add R_ES "$("$BIN/scenario" --run-id dedupe-R_ES esbuild 0.0.12 0.0.13)"
    add R_UNCH "$("$BIN/scenario" --run-id dedupe-R_UNCH esbuild 0.0.12 0.0.13)"
    add R_BADUTF "$("$BIN/scenario" --run-id dedupe-R_BADUTF esbuild 0.0.12 0.0.13)"
    add R_OFF "$("$BIN/scenario" --run-id dedupe-R_OFF --offline corp-pkg 1.0.0 2.0.0)"
    add R_FIRST "$("$BIN/scenario" --run-id dedupe-R_FIRST --first-run esbuild 0.0.12 0.0.13)"
    add R_ALLOW "$("$BIN/scenario" --run-id dedupe-R_ALLOW --base-config "$allow" .capdelta.yml husky 5.0.9 5.1.0)"
    add R_CFG "$("$BIN/scenario" --run-id dedupe-R_CFG --base-config "$allow" cfg/policy.yml husky 5.0.9 5.1.0)"
    add R_AX "$("$BIN/scenario" --run-id dedupe-R_AX axios 0.27.2 1.0.0)"
  } >"$staging"
  mv "$staging" "$SCENARIOS"
  # shellcheck source=/dev/null
  . "$SCENARIOS"
  git -C "$R_UNCH" checkout -- .
  printf '\xff\xfe{"lockfileVersion":3}\n' >"$R_BADUTF/package-lock.json"
  cat "$SCENARIOS"
}

# Records one line per intelligence verdict state. The evidence path and the
# service port change between runs, so strip both before keeping the rows.
intel_matrix() {
  local run_dir="$CAPDELTA_VERIFY_EVIDENCE/$1-intel"
  local log="$run_dir/console.log"
  local out="$CAPDELTA_VERIFY_EVIDENCE/$1/intel-matrix.txt"
  local status=0 raw rows state
  rm -rf "${run_dir:?}"
  mkdir -p "$run_dir"
  raw="$(CAPDELTA_VERIFY_RUN_ID="$1-intel" "$BIN/intel-drive" 2>&1)" || status=$?
  printf '%s\n' "$raw" >"$log"
  if [ "$status" -ne 0 ]; then
    if grep -q 'registry metadata fetch failed' "$log"; then
      printf 'replay: cannot reach registry.npmjs.org for the intel matrix (see %s)\n' "$log" >&2
    else
      printf 'replay: intel-drive failed for %s, exit %s (see %s)\n' "$1" "$status" "$log" >&2
    fi
    exit 2
  fi
  rows="$(
    printf '%s\n' "$raw" |
      sed -E -e 's#(https?://(127\.0\.0\.1|localhost|\[::1\])):[0-9]+#\1#g' \
        -e 's#/[^ ]*capdelta-verify/[^ ]*#<evidence>#g' |
      sed -nE \
        -e 's/^(ok|MISMATCH)[[:space:]]+([a-z0-9-]+)[[:space:]]+exit ([0-9]+).*[[:space:]]kinds ([a-z0-9,-]+).*/\2 exit=\3 kinds=\4/p' \
        -e 's/^(ok|MISMATCH)[[:space:]]+([a-z0-9-]+)[[:space:]]+exit ([0-9]+).*/\2 exit=\3 kinds=none/p'
  )"
  for state in no-intel suspected confirmed retracted service-down bad-url; do
    if ! printf '%s\n' "$rows" | grep -q "^$state "; then
      printf 'replay: intel matrix for %s has no %s row (see %s)\n' "$1" "$state" "$log" >&2
      exit 2
    fi
  done
  printf '%s\n' "$rows" >"$out"
}

record() {
  local label="$1"
  if [ ! -f "$SCENARIOS" ]; then
    printf 'replay: %s is missing; run: replay setup\n' "$SCENARIOS" >&2
    exit 2
  fi
  if [ ! -f "$ROOT/dist/cli.js" ]; then
    printf 'replay: %s is missing; run: npm run build\n' "$ROOT/dist/cli.js" >&2
    exit 2
  fi
  export TMPDIR="$SCRATCH"
  export CAPDELTA_VERIFY_EVIDENCE="$EVIDENCE"
  # shellcheck source=/dev/null
  . "$SCENARIOS"
  RUN="dedupe-$label"
  rm -rf "${CAPDELTA_VERIFY_EVIDENCE:?}/${RUN:?}" "${CAPDELTA_VERIFY_EVIDENCE:?}/${RUN:?}-intel"
  d() {
    local repo="$1" name="$2"
    shift 2
    # A drive exits 1 or 2 on purpose; the recording keeps that exit code.
    "$BIN/drive" --run-id "$RUN" --repo "$repo" --name "$name" -- "$@" >/dev/null 2>&1 || true
  }
  d "$R_ES" es-text --base HEAD
  d "$R_ES" es-json --base HEAD --format json
  d "$R_ES" es-high --base HEAD --fail-on HIGH
  d "$R_ES" es-none-json --base HEAD --format json --fail-on none
  d "$R_OFF" off-strict --base HEAD --strict
  d "$R_OFF" off-json --base HEAD --format json
  d "$R_FIRST" first-text --base HEAD
  d "$R_FIRST" first-json --base HEAD --format json
  d "$R_ALLOW" allow-text --base HEAD --fail-on HIGH
  d "$R_ALLOW" allow-json --base HEAD --format json --fail-on HIGH
  d "$R_CFG" cfg-text --base HEAD --fail-on HIGH --config cfg/policy.yml
  d "$R_AX" ax-text --base HEAD --fail-on none
  d "$R_AX" ax-json --base HEAD --format json --fail-on none
  d "$R_UNCH" unchanged --base HEAD
  d "$R_BADUTF" bad-utf8 --base HEAD
  d "$R_ES" usage-format --base HEAD --format xml
  d "$R_ES" usage-base-missing --base
  d "$R_ES" usage-config-missing --base HEAD --config
  d "$R_ES" usage-config-dup --base HEAD --config a --config b
  d "$R_ES" usage-base-dup --base HEAD --base HEAD
  intel_matrix "$RUN"
  rm -f "$CAPDELTA_VERIFY_EVIDENCE/$RUN"/*.cmd
  printf '%s\n' "$CAPDELTA_VERIFY_EVIDENCE/$RUN"
}

compare() {
  local base="$1" head="$2"
  local b="$EVIDENCE/dedupe-$base" h="$EVIDENCE/dedupe-$head"
  local status=0 f name
  if [ ! -d "$b" ]; then
    printf 'replay: no recording for %s at %s\n' "$base" "$b" >&2
    exit 2
  fi
  if [ ! -d "$h" ]; then
    printf 'replay: no recording for %s at %s\n' "$head" "$h" >&2
    exit 2
  fi
  diff -r -x compare.txt "$b" "$h" || status=1
  for f in "$h"/*json.out; do
    [ -e "$f" ] || continue
    name="$(basename "$f" .out)"
    local severity
    severity="$(node -e 'const r=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));console.log(JSON.stringify(r.summary?.gateSeverity))' "$f")" || {
      printf 'replay: cannot read gateSeverity from %s\n' "$f" >&2
      exit 2
    }
    printf '%s exit=%s gateSeverity=%s\n' "$name" "$(cat "$h/$name.exit")" "$severity"
  done
  if [ -f "$h/intel-matrix.txt" ]; then
    while read -r state rest; do
      printf 'intel %s %s\n' "$state" "$rest"
    done <"$h/intel-matrix.txt"
  fi
  if [ "$status" -eq 0 ]; then
    printf 'MATCH: %s == %s\n' "$base" "$head"
  else
    printf 'MISMATCH: %s != %s\n' "$base" "$head"
  fi
  exit "$status"
}

[ "$#" -ge 1 ] || usage
CMD="$1"
shift
case "$CMD" in
  setup)
    [ "$#" -eq 0 ] || usage
    setup
    ;;
  record)
    [ "$#" -eq 1 ] || usage
    record "$1"
    ;;
  compare)
    [ "$#" -eq 2 ] || usage
    compare "$1" "$2"
    ;;
  *) usage ;;
esac
