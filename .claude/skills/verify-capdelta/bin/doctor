#!/usr/bin/env bash
set -eu
BIN="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$BIN/../../../.." && pwd)"
CLI="$ROOT/dist/cli.js"
status=0
fail() {
  printf 'doctor: FAIL - %s\n' "$1"
  status=1
}
if command -v node >/dev/null 2>&1 && [ "$(node -p 'process.versions.node.split(".")[0]')" -ge 20 ]; then
  printf 'doctor: ok - node %s (>= 20)\n' "$(node -v)"
else
  fail "node >= 20 required"
fi
if command -v git >/dev/null 2>&1; then
  printf 'doctor: ok - %s\n' "$(git --version)"
else
  fail "git not found on PATH"
fi
if [ ! -f "$CLI" ]; then
  fail "dist/cli.js missing; run: npm run build"
elif [ -n "$(find "$ROOT/src" -type f -newer "$CLI" -print -quit)" ]; then
  fail "dist/cli.js older than src/; run: npm run build"
else
  printf 'doctor: ok - dist/cli.js is present and newer than src/\n'
fi
if [ -f "$CLI" ] && node "$CLI" --help >/dev/null 2>&1; then
  printf 'doctor: ok - node dist/cli.js --help exits 0\n'
else
  fail "node dist/cli.js --help did not exit 0"
fi
if command -v npm >/dev/null 2>&1 && npm view esbuild version >/dev/null 2>&1; then
  printf 'doctor: ok - registry.npmjs.org is reachable\n'
else
  fail "registry.npmjs.org is not reachable"
fi
exit "$status"
