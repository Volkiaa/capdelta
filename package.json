{
  "name": "capdelta",
  "version": "0.0.0",
  "description": "npm dependency behavioral diff: what can the new version do that the old one couldn't?",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "capdelta": "dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "SECURITY.md"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "prepack": "npm run build",
    "check:deps": "node scripts/check-dep-budget.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "tar": "^7.5.19"
  }
}
