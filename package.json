{
  "name": "capdelta",
  "version": "0.0.0",
  "description": "npm dependency behavioral diff: what can the new version do that the old one couldn't?",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "capdelta": "dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "SECURITY.md"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "package:action": "node scripts/package-action.mjs",
    "check:action": "npm run package:action && git diff --exit-code -- dist/action",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "prepack": "npm run build",
    "check:deps": "node scripts/check-dep-budget.mjs",
    "fp-check": "tsx scripts/fp-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vercel/ncc": "^0.44.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "jsonc-parser": "^3.3.1",
    "tar": "^7.5.22"
  }
}
